---
// Renders its slot — a sidebar subtree with no active page in it — through the
// build-time subtree cache (see nav-cache.ts), so a large sidebar is rendered
// once per group instead of once per page. Off in dev, where component edits
// must show on the next request. The cached HTML references the page's icon
// sprite (see icon-sprite.ts), so the symbols it used ride along and are
// registered into whichever page reuses it.
import type { NavNode } from "../../core/types.ts";
import { iconSpriteFor, referencedIconSymbols } from "../icon-sprite.ts";
import type { IconSymbol } from "../icon-sprite.ts";
import { cachedNavSubtree } from "./nav-cache.ts";

interface Props {
  node: NavNode;
  variant: string;
}

const { node, variant } = Astro.props;
const sprite = iconSpriteFor(Astro.locals);
const { html, icons } = await cachedNavSubtree(
  node,
  variant,
  async () => {
    const rendered = await Astro.slots.render("default");
    const used: [string, IconSymbol][] = [];
    for (const id of referencedIconSymbols(rendered)) {
      const symbol = sprite?.symbols.get(id);
      if (symbol) {
        used.push([id, symbol]);
      }
    }
    return { html: rendered, icons: used };
  },
  !import.meta.env.DEV
);
if (sprite) {
  for (const [id, symbol] of icons) {
    if (!sprite.symbols.has(id)) {
      sprite.symbols.set(id, symbol);
    }
  }
}
---

<Fragment set:html={html} />
