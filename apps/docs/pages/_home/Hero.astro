---
// Landing hero: latest-release badge, headline, install box, and doc/GitHub
// links. The install box copy button uses the page-level delegated
// `data-blume-copy-install` handler in index.astro.
import data from "blume:data";
import InstallBox from "./InstallBox.astro";
import { glyph } from "./shared.ts";

const { config } = data;
const repoUrl = config.repoUrl;
const docsHref = "/docs";
const chevronRight = glyph("chevron-right");

// Latest release for the hero badge, read from the changelog the
// `githubReleases` content source materializes (`/changelog/<tag>` routes,
// titled by release name, e.g. `blume@1.7.3`). The source already fetches
// with `GITHUB_TOKEN` and keeps a snapshot cache, so the badge can never
// disagree with /changelog — an unauthenticated fetch from a CI runner used to
// hit GitHub's rate limit and silently leave the badge on its fallback.
const toTime = (value: string | null): number =>
  value ? new Date(value).getTime() : 0;
const latestRelease = data.routes
  .filter((route) => route.path.startsWith("/changelog/") && !route.draft)
  .toSorted((a, b) => toTime(b.lastModified) - toTime(a.lastModified))
  .at(0);
// Release names are changesets-style (`blume@1.0.0`), but tolerate a plain
// `v1.0.0` too — drop any package prefix and the leading `v`.
const latestVersion = latestRelease
  ? latestRelease.title.replace(/^.*@/u, "").replace(/^v/u, "")
  : "0.0.0";
---

<section class="text-center">
  <a
    class="inline-flex items-center px-3 py-1 text-muted-foreground text-xs transition-colors hover:text-foreground"
    href="/changelog"
  >
    Latest update, v{latestVersion}
  </a>
  <h1
    class="mx-auto mt-6 max-w-3xl text-balance font-medium text-4xl sm:text-5xl lg:text-6xl"
  >
    <span class="block">World-class docs for</span>
    <span class="block text-muted-foreground">everything you ship.</span>
  </h1>
  <p class="mx-auto mt-6 max-w-xl text-balance text-lg text-muted-foreground">
    Fast, AI-ready, and zero-config. Drop Markdown into a folder and ship a
    production-grade docs site, no app boilerplate to write or maintain. Free
    and open source, forever.
  </p>

  <!-- Install command -->
  <div class="mt-9"><InstallBox /></div>

  <div class="mt-7 flex items-center justify-center gap-6 text-sm">
    <a
      class="inline-flex items-center gap-1 font-medium text-muted-foreground transition-colors hover:text-foreground"
      href={docsHref}
    >
      Read the docs
      <svg
        class="size-3.5"
        fill="none"
        height="14"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="14"
        xmlns="http://www.w3.org/2000/svg"
        set:html={chevronRight}
      ></svg>
    </a>
    {
      repoUrl && (
        <a
          class="inline-flex items-center gap-1 font-medium text-muted-foreground transition-colors hover:text-foreground"
          href={repoUrl}
          rel="noreferrer"
          target="_blank"
        >
          View the code
          <svg
            class="size-3.5"
            fill="none"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
            set:html={chevronRight}
          />
        </a>
      )
    }
  </div>
</section>
